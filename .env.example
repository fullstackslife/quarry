# LM Studio (Developer page → Manage Tokens). Required when auth is on.
LM_API_TOKEN=

# OpenAI-compat base. Host:port from the Developer page is enough; /v1 is added.
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# Optional. Enables the hosted Grok fallback when LM Studio is not running.
# Get a key at https://console.x.ai
XAI_API_KEY=
